# Production environment template for Railway
# Copy to .env.production locally for testing, or set these as Railway Variables

# Node
NODE_ENV=production

# Admin auth (MUST change)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change_me_strong_pw

# Database (Railway MySQL)
DB_HOST=containers-us-west-xxx.railway.app
DB_PORT=12345
DB_USER=railway
DB_PASSWORD=your_db_password
DB_NAME=ow_farm

# Uploads storage
# If using a Railway Volume mounted at /data, keep this path
UPLOADS_DIR=/data/uploads

# If using Cloudinary/S3 instead of local uploads, comment the above and set your provider variables
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or AWS credentials + bucket (if using S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
